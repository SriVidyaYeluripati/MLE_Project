+        st['d_sum'] = st.get('d_sum', 0) + d_here
+        closer = [a for i, a in enumerate(ACTIONS)
+                  if mask[i] and phi[i, COIN_DELTA] < 0]
+        if not closer:
+            st['boxed_in'] = st.get('boxed_in', 0) + 1
+        else:
+            st['could_approach'] = st.get('could_approach', 0) + 1
+            if chosen in closer:
